{
  "schema_version": 1,
  "channels": [
    {
      "name": "github",
      "description": "GitHub 仓库和代码",
      "level": "default",
      "login": null,
      "actions": [
        {
          "name": "search",
          "help": "Search repositories",
          "usage": "agent-reach github search <query> [--limit LIMIT]",
          "params": [
            {
              "name": "query",
              "help": "what to search for",
              "required": true,
              "type": "str",
              "default": null
            },
            {
              "name": "limit",
              "help": "max results",
              "required": false,
              "type": "int",
              "default": 5
            }
          ],
          "public_web": [],
          "backends": [
            [
              "gh",
              "_gh_search"
            ],
            [
              "github-api",
              "_api_search"
            ]
          ],
          "live_test": {
            "query": "yt-dlp",
            "limit": 2
          },
          "timeout": null
        },
        {
          "name": "read",
          "help": "Read a repository (with README) or an issue / PR (with comments)",
          "usage": "agent-reach github read <target>",
          "params": [
            {
              "name": "target",
              "help": "owner/repo, or a repo / issue / PR link",
              "required": true,
              "type": "str",
              "default": null
            }
          ],
          "public_web": [],
          "backends": [
            [
              "gh",
              "_gh_read"
            ],
            [
              "github-api",
              "_api_read"
            ]
          ],
          "live_test": {
            "target": "yt-dlp/yt-dlp"
          },
          "timeout": null
        }
      ]
    },
