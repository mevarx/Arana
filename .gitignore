# Rust build output
/target/
/dist/

# Local verification output, regenerated by scripts/verify.py and scripts/package_release.py
/artifacts/

# Isolated pinned upstream environment used by scripts/differential.py
/.upstream-venv/
/.upstream-home/

# Scratch state root used by local CLI probes
/.arana-test/

# Local notes kept out of the published tree (see also .git/info/exclude)
/PORT_PLAN.md

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Logs, editor and OS noise
*.log
*.tmp
*.swp
*.orig
*.rej
.DS_Store
Thumbs.db
desktop.ini

